# Public hostname for the Hub (Let's Encrypt via Caddy). WAHA/n8n are not covered.
APP_DOMAIN=app.cravingcodetech.in

# Optional: for Call Analysis AI (summary, sentiment, key points, next action)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Alternative env name (either works)
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: language for transcription (e.g. en-US, hi-IN, es-ES). Default: en-US
# TRANSCRIPT_LANGUAGE=en-US
