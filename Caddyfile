# Hub only. WAHA (:3000) and n8n (:5678) stay HTTP — do not add them here.
{$APP_DOMAIN:app.cravingcodetech.in} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy buildesk-frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}
